      <coluna nome="entidade" tipo="varchar" tamanho="30" chave-primaria="nao" nulo="nao"/>
      <coluna nome="registro_id" tipo="int" chave-primaria="nao" nulo="nao"/>
      <coluna nome="acao" tipo="varchar" tamanho="30" chave-primaria="nao" nulo="nao"/>
      <coluna nome="autor_id" tipo="int" chave-primaria="nao" nulo="nao"/>
      <coluna nome="justificativa" tipo="varchar" tamanho="300" chave-primaria="nao" nulo="sim"/>
      <coluna nome="valor_anterior" tipo="text" chave-primaria="nao" nulo="sim"/>
      <coluna nome="valor_novo" tipo="text" chave-primaria="nao" nulo="sim"/>
