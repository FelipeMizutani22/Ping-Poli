  <unicidades>
    <unicidade nome="curso_nome_uk" tabela="curso" colunas="nome"/>
    <unicidade nome="atleta_nusp_uk" tabela="atleta" colunas="nusp" regra="RN02"/>
    <unicidade nome="atleta_email_uk" tabela="atleta" colunas="email" regra="UC02 E4"/>
    <unicidade nome="token_hash_uk" tabela="token_redefinicao" colunas="token_hash"/>
    <unicidade nome="categoria_nome_uk" tabela="categoria" colunas="campeonato_id, lower(nome)" regra="UC12"/>
    <unicidade nome="inscricao_atleta_categoria_uk" tabela="inscricao" colunas="categoria_id, atleta_id" filtro="status = 'ativa'" regra="UC13 E5"/>
    <unicidade nome="adversario_externo_uk" tabela="adversario_externo" colunas="lower(nome), lower(coalesce(clube, ''))" regra="RN23"/>
    <unicidade nome="contestacao_aberta_uk" tabela="contestacao" colunas="partida_id" filtro="data_resolucao is null"/>
    <unicidade nome="set_partida_numero_uk" tabela="set_partida" colunas="partida_id, numero" filtro="contestacao_id is null"/>
    <unicidade nome="set_contestacao_numero_uk" tabela="set_partida" colunas="contestacao_id, numero" filtro="contestacao_id is not null"/>
  </unicidades>

  <restricoes>
    <restricao nome="atleta_nusp_ck" tabela="atleta" regra="RN02">nusp between 1 and 99999999</restricao>
    <restricao nome="atleta_email_ck" tabela="atleta" regra="RN01">email = lower(email) and email like '%@usp.br'</restricao>
    <restricao nome="atleta_papel_ck" tabela="atleta">papel in ('atleta', 'diretor')</restricao>
    <restricao nome="atleta_situacao_ck" tabela="atleta">situacao in ('pendente', 'ativa', 'recusada', 'inativa')</restricao>
    <restricao nome="atleta_mao_ck" tabela="atleta">mao_dominante is null or mao_dominante in ('destro', 'canhoto')</restricao>
    <restricao nome="atleta_ano_ck" tabela="atleta">ano_ingresso between 1900 and 2200</restricao>
    <restricao nome="atleta_tentativas_ck" tabela="atleta">tentativas_login &gt;= 0</restricao>
    <restricao nome="atleta_recusa_ck" tabela="atleta" regra="UC03">situacao &lt;&gt; 'recusada' or motivo_recusa is not null</restricao>
    <restricao nome="token_validade_ck" tabela="token_redefinicao" regra="RN06">expira_em &gt; criado_em</restricao>
    <restricao nome="serie_recorrencia_ck" tabela="serie_evento">recorrencia in ('semanal')</restricao>
    <restricao nome="serie_periodo_ck" tabela="serie_evento" regra="UC07">data_fim &gt; data_inicio and data_fim &lt;= data_inicio + interval '6 months'</restricao>
    <restricao nome="evento_tipo_ck" tabela="evento">tipo in ('treino', 'atividade', 'campeonato')</restricao>
    <restricao nome="evento_status_ck" tabela="evento">status in ('agendado', 'cancelado', 'realizado')</restricao>
    <restricao nome="evento_hora_ck" tabela="evento">hora_fim &gt; hora_inicio</restricao>
    <restricao nome="campeonato_status_ck" tabela="campeonato">status in ('planejado', 'inscricoes_abertas', 'inscricoes_encerradas', 'finalizado', 'cancelado')</restricao>
    <restricao nome="campeonato_datas_ck" tabela="campeonato">data_fim &gt;= data_inicio</restricao>
    <restricao nome="campeonato_prazo_ck" tabela="campeonato">encerramento_inscricoes &gt; abertura_inscricoes</restricao>
    <restricao nome="campeonato_valor_ck" tabela="campeonato">valor_inscricao is null or valor_inscricao &gt;= 0</restricao>
    <restricao nome="categoria_vagas_ck" tabela="categoria">vagas is null or vagas &gt; 0</restricao>
    <restricao nome="inscricao_status_ck" tabela="inscricao">status in ('ativa', 'cancelada')</restricao>
    <restricao nome="inscricao_colocacao_ck" tabela="inscricao" regra="RN25">colocacao is null or colocacao &gt;= 1</restricao>
    <restricao nome="inscricao_coloc_ativa_ck" tabela="inscricao" regra="RN25">colocacao is null or status = 'ativa'</restricao>
    <restricao nome="inscricao_cancel_ck" tabela="inscricao" regra="UC14 A3">status &lt;&gt; 'cancelada' or motivo_cancelamento is not null</restricao>
    <restricao nome="partida_status_ck" tabela="partida">status in ('pendente', 'confirmada', 'contestada', 'removida')</restricao>
    <restricao nome="partida_formato_ck" tabela="partida" regra="RN08">formato in (3, 5, 7)</restricao>
    <restricao nome="partida_adversario_xor_ck" tabela="partida" tipo="associacao-exclusiva">(tipo_adversario = 'poli' and adversario_id is not null and adversario_externo_id is null) or (tipo_adversario = 'externo' and adversario_id is null and adversario_externo_id is not null)</restricao>
    <restricao nome="partida_auto_ck" tabela="partida">adversario_id is null or adversario_id &lt;&gt; atleta_id</restricao>
    <restricao nome="contestacao_justif_ck" tabela="contestacao" regra="RN21">char_length(justificativa) between 10 and 500</restricao>
    <restricao nome="contestacao_resolucao_ck" tabela="contestacao" regra="UC17">(resolvida_por is null and motivo_decisao is null and data_resolucao is null) or (resolvida_por is not null and motivo_decisao is not null and data_resolucao is not null)</restricao>
    <restricao nome="set_numero_ck" tabela="set_partida">numero between 1 and 7</restricao>
    <restricao nome="set_pontos_ck" tabela="set_partida">pontos_atleta &gt;= 0 and pontos_adversario &gt;= 0</restricao>
    <restricao nome="set_placar_ck" tabela="set_partida" regra="RN08">(pontos_atleta &gt;= 11 and pontos_atleta - pontos_adversario &gt;= 2) or (pontos_adversario &gt;= 11 and pontos_adversario - pontos_atleta &gt;= 2)</restricao>
    <restricao nome="historico_motivo_ck" tabela="historico_partida">char_length(motivo) between 10 and 300</restricao>
    <restricao nome="rotina_periodo_ck" tabela="execucao_rotina">fim is null or fim &gt;= inicio</restricao>
    <restricao nome="rotina_afetados_ck" tabela="execucao_rotina">registros_afetados &gt;= 0</restricao>
