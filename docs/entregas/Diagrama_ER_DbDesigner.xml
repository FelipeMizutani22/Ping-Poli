    </tabela>

    <tabela nome="notificacao">
      <coluna nome="id" tipo="int" chave-primaria="sim" nulo="nao" auto-incremento="sim"/>
      <coluna nome="destinatario_id" tipo="int" chave-primaria="nao" nulo="nao"/>
      <coluna nome="tipo" tipo="varchar" tamanho="30" chave-primaria="nao" nulo="nao"/>
      <coluna nome="mensagem" tipo="varchar" tamanho="300" chave-primaria="nao" nulo="nao"/>
      <coluna nome="link" tipo="varchar" tamanho="255" chave-primaria="nao" nulo="sim"/>
