      <coluna nome="adversario_id" tipo="int" chave-primaria="nao" nulo="sim"/>
      <coluna nome="adversario_externo_id" tipo="int" chave-primaria="nao" nulo="sim"/>
      <coluna nome="tipo_adversario" tipo="varchar" tamanho="10" chave-primaria="nao" nulo="nao"/>
      <coluna nome="campeonato_id" tipo="int" chave-primaria="nao" nulo="sim"/>
      <coluna nome="categoria_id" tipo="int" chave-primaria="nao" nulo="sim"/>
      <coluna nome="fase" tipo="varchar" tamanho="50" chave-primaria="nao" nulo="sim"/>
      <coluna nome="formato" tipo="int" chave-primaria="nao" nulo="nao"/>
      <coluna nome="data_jogo" tipo="date" chave-primaria="nao" nulo="nao"/>
      <coluna nome="status" tipo="varchar" tamanho="15" chave-primaria="nao" nulo="nao"/>
      <coluna nome="observacoes" tipo="varchar" tamanho="300" chave-primaria="nao" nulo="sim"/>
      <coluna nome="data_registro" tipo="timestamp" chave-primaria="nao" nulo="nao"/>
