      <coluna nome="contestante_id" tipo="int" chave-primaria="nao" nulo="nao"/>
      <coluna nome="justificativa" tipo="varchar" tamanho="500" chave-primaria="nao" nulo="nao"/>
      <coluna nome="data_contestacao" tipo="timestamp" chave-primaria="nao" nulo="nao"/>
      <coluna nome="resolvida_por" tipo="int" chave-primaria="nao" nulo="sim"/>
      <coluna nome="motivo_decisao" tipo="varchar" tamanho="300" chave-primaria="nao" nulo="sim"/>
